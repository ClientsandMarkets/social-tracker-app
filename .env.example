# Any Postgres connection string — Vercel Postgres, Neon, Supabase, etc.
POSTGRES_URL=

# From a Vercel Blob store (Vercel dashboard → Storage → Blob). Without
# this, collateral upload 501s but pasting a link to existing storage
# still works.
BLOB_READ_WRITE_TOKEN=

# Microsoft Teams incoming webhook URL for the shared channel notifications
# post to.
TEAMS_WEBHOOK_URL=

# Any random string. Set the same value in the Vercel project's env vars —
# Vercel Cron sends it automatically as a bearer token on scheduled hits.
CRON_SECRET=
